{
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun run build:electron && electron .",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "bun run typecheck && bun run build:renderer && bun run build:electron",
    "dist:win": "bun run build && electron-builder --win nsis --x64 --publish never",
    "icon": "python3 scripts/make-icon.py"
  },
  "trustedDependencies": [
    "electron"
  ],
  "name": "ember-arena-desktop",
  "productName": "Ember Arena",
  "version": "1.0.0",
  "description": "Ember Arena desktop player app for Windows (virtual coins only)",
  "author": "Ember Arena",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}